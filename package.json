{
  "name": "unblockedtdm-build-system",
  "private": true,
  "version": "1.0.0",
  "description": "Build and release tooling for Skirmish Arena",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "launcher": "electron launcher",
    "game": "electron game",
    "sync:build": "node scripts/sync-build-info.mjs",
    "build:game": "electron-builder --projectDir game --config electron-builder.yml --win portable --x64 --publish never",
    "smoke:packaged": "node scripts/smoke-packaged-game.mjs",
    "build:launcher": "electron-builder --projectDir launcher --config electron-builder.yml --win nsis --x64 --publish never",
    "build:windows": "npm run sync:build && npm run build:game && npm run smoke:packaged && npm run build:launcher",
    "check": "node scripts/check-all.mjs"
  }
}
